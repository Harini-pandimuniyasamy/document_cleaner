# MongoDB Atlas Connection URI (Required)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai_document_cleaner?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret or Token for user authentication (Required in production)
JWT_SECRET=docuclean_ai_production_secret_key_2026

# Google Gemini API Key (Required for AI document cleaning & restoration)
GEMINI_API_KEY=

# Allowed Client URL for CORS (e.g. Vercel deployment URL or http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Port for backend Express server (Defaults to 3000)
PORT=3000
